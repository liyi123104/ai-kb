# 统一用 LF 存储，检出时按平台处理
* text=auto eol=lf

# 二进制文件不要做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.mp4  binary
*.zip  binary

# 文档与配置按文本处理
*.md   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.vue  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf