# ===== 模型（计划书 2.1：用 LLM_PROVIDER 切换，业务代码不硬编码模型）=====
# 开发用本地 Ollama（免费）；演示可改成 deepseek（云端，效果好）
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 云端（LLM_PROVIDER=deepseek 时才需要）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxxx

# ===== 检索 =====
# 入库优化：向量模型放 GPU（入库不生成，让出显存能快约 12 倍）；显存紧张时设为 0
INGEST_USE_GPU=1
# PDF 文本提取器：fitz（PyMuPDF，快约 30 倍）或 pypdf（兜底）
PDF_EXTRACTOR=fitz

# 访问令牌：留空=不鉴权（本机自用）。填了之后打开界面登录一次即可，
# 后端下发 7 天会话 Cookie；也支持请求头 X-Auth-Token 或 ?token= 分享链接。
# 公网部署务必填一个。
AUTH_TOKEN=

# 向量库集合：ai-kb 是全量库；ai-kb-ai 只含 AI 资料（检索更快，见 scripts/split_library.py）
CHROMA_COLLECTION=ai-kb

# 列表式重排：实测无收益且变慢 5 倍（见 docs/experiments.md E2），默认关闭
RERANK=0

# ---- 公网部署加固（本机自用可保持默认）----
# 每个 IP 每分钟的请求上限；上传单独更严。0 表示关闭限流。
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=30
# 生产环境建议关掉接口文档（/docs、/redoc、/openapi.json）
DOCS_ENABLED=1
# 走 HTTPS 时设为 1，会话 Cookie 会加 Secure 标记
COOKIE_SECURE=0
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5
# 最佳相似度低于这个值就直接回答「资料中没有相关内容」（实测：相关问题 0.59+，无关 0.35 以下）
RAG_SCORE_GATE=0.45

# ===== 存储 =====
CHROMA_COLLECTION=ai-kb

# 列表式重排：实测无收益且变慢 5 倍（见 docs/experiments.md E2），默认关闭
RERANK=0

# ---- 公网部署加固（本机自用可保持默认）----
# 每个 IP 每分钟的请求上限；上传单独更严。0 表示关闭限流。
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=30
# 生产环境建议关掉接口文档（/docs、/redoc、/openapi.json）
DOCS_ENABLED=1
# 走 HTTPS 时设为 1，会话 Cookie 会加 Secure 标记
COOKIE_SECURE=0

# ===== 服务 =====
APP_HOST=0.0.0.0
APP_PORT=8000
