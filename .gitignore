data/app.db
data/app.db-wal
data/app.db-shm

# 上传的原始文件（运行时产生）
data/uploads/*
!data/uploads/.gitkeep

# 学习资料：10 份 PDF，约 80MB，不进 Git
materials/

# 前端依赖与构建产物
web/node_modules/
web/dist/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 日志
*.log

# pip / torch 运行期临时目录
pip-build-tracker-*/
pip-download-*/
pip-ephem-wheel-cache-*/
pip-install-*/
torchinductor_*/

# chromadb 运行期临时目录
data/tmp/

# 截图脚本用的 Edge 临时配置
data/edge-*/

# 计划书 v1.0 备份（历史留档，不进库）
docs/*_v1.0_backup.docx

# 打包产物（scripts/package.py 生成）
dist/

# 数据备份（scripts/backup_data.py 生成，体积大）
backups/

